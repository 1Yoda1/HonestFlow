<Window x:Class="HonestFlow.WpfPrototype.ServiceAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сервисный доступ" Width="430" Height="285"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F7F9FC" FontFamily="Segoe UI">
  <Border Margin="18" Padding="22" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Сервисный доступ" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="1" Text="Этот вход открывает только установку компонентов и не авторизует HonestFlow для работы."
                 Foreground="#667085" TextWrapping="Wrap" Margin="0,7,0,15"/>
      <StackPanel Grid.Row="2">
        <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordInput" Height="42" Padding="10,7"/>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#D91532" TextWrapping="Wrap"
                 Margin="0,7,0,0" Visibility="Collapsed"/>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
        <Button x:Name="CancelButton" Content="Отмена" Width="110" Height="40" Margin="0,0,10,0" Click="Cancel_Click"/>
        <Button x:Name="ContinueButton" Content="Продолжить" Width="130" Height="40" IsDefault="True" Click="Continue_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
