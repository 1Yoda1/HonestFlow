<Window x:Class="HonestFlow.WpfPrototype.DeveloperDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HonestFlow — Developer Diagnostics"
        Width="1320" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F7F8FB"
        FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="White" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="10" Padding="18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Developer Diagnostics" FontSize="22" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="WorkState: " FontWeight="SemiBold"/>
            <TextBlock x:Name="WorkStateText"/>
            <TextBlock Text="   Snapshot UTC: " FontWeight="SemiBold"/>
            <TextBlock x:Name="SnapshotTimestampText"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="1" Content="Проверить снова" Width="170" Height="42" Click="Refresh_Click"/>
      </Grid>
    </Border>

    <TabControl Grid.Row="2">
      <TabItem Header="Issues">
        <DataGrid x:Name="IssuesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="210"/>
            <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="120"/>
            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="125"/>
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="210"/>
            <DataGridTextColumn Header="UserMessage" Binding="{Binding UserMessage}" Width="280"/>
            <DataGridTextColumn Header="SuggestedFix" Binding="{Binding SuggestedFix}" Width="150"/>
            <DataGridTextColumn Header="TechnicalDetails" Binding="{Binding TechnicalDetails}" Width="360"/>
            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="300"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Facts / Evidence">
        <DataGrid x:Name="FactsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="240"/>
            <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="140"/>
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/>
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="250"/>
            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,0,0" Foreground="#667085"/>
  </Grid>
</Window>
