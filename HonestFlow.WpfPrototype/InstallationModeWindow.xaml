<Window x:Class="HonestFlow.WpfPrototype.InstallationModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HonestFlow — Только установка" Width="880" Height="650"
        MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/>
      <RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="#102039" CornerRadius="12" Padding="22">
      <StackPanel>
        <TextBlock Text="Только установка" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="Сервисный режим. Доступны только установка и переустановка компонентов."
                   Foreground="#C9D6E7" FontSize="14" Margin="0,7,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="12" Padding="18">
      <DataGrid x:Name="ComponentsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="ВЫБРАТЬ" Binding="{Binding IsSelected}" Width="90"/>
          <DataGridTextColumn Header="КОМПОНЕНТ" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
          <DataGridTextColumn Header="ВЕРСИЯ" Binding="{Binding Version}" IsReadOnly="True" Width="150"/>
          <DataGridTextColumn Header="УСТАНОВОЧНЫЙ ФАЙЛ" Binding="{Binding FileName}" IsReadOnly="True" Width="260"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="4">
      <ProgressBar x:Name="OperationProgress" Height="12" Minimum="0" Maximum="100"/>
      <TextBlock x:Name="StatusText" Text="Выберите действие." Foreground="#596579" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>

    <Grid Grid.Row="6">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="InstallButton" Content="Установить недостающие" Height="44" Padding="18,0" Click="Install_Click"/>
        <Button x:Name="ReinstallButton" Content="Переустановить выбранные" Height="44" Padding="18,0" Margin="10,0,0,0" Click="Reinstall_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Вернуться ко входу" Height="44" Padding="16,0" Margin="0,0,10,0" Click="Return_Click"/>
        <Button Content="Закрыть" Height="44" Padding="16,0" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
