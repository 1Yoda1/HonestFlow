<Window x:Class="HonestFlow.WpfPrototype.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HonestFlow" Width="980" Height="680" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#F7F8FB" FontFamily="Segoe UI" Foreground="#111827"
        Loaded="Window_Loaded">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#0967D9"/>
    <SolidColorBrush x:Key="DarkBlue" Color="#102342"/>
    <SolidColorBrush x:Key="Muted" Color="#667085"/>
    <SolidColorBrush x:Key="Line" Color="#E4E8F0"/>
    <SolidColorBrush x:Key="Green" Color="#0E9F6E"/>
    <SolidColorBrush x:Key="Red" Color="#D91532"/>
    <Style x:Key="TopButton" TargetType="Button">
      <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EDF1F7"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="18,0"/>
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#D8DEE9"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.9"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#0868D9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0868D9"/>
    </Style>
    <Style x:Key="StepBadge" TargetType="Border">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="15"/>
      <Setter Property="BorderBrush" Value="#536985"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#E1E5EC" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="White" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
          <Grid Width="38" Height="38"><Polygon Fill="#1467C9" Points="19,0 36,10 36,28 19,38 2,28 2,10"/><TextBlock Text="HF" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          <TextBlock Text="HonestFlow" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource TopButton}" Content="−" Click="Minimize_Click"/><Button Style="{StaticResource TopButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource TopButton}" Content="×" FontSize="24" Click="Close_Click"/></StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="34"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource DarkBlue}" CornerRadius="13" Padding="36,38">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Подготовка рабочего места" Foreground="White" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Загружаем конфигурацию точки, проверяем доступ и готовим HonestFlow к работе." Foreground="#C9D5E7" FontSize="15" LineHeight="24" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
              <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource StepBadge}" Background="{StaticResource Green}" BorderBrush="{StaticResource Green}"><TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Конфигурация" Foreground="#DCE8F7" FontSize="15" VerticalAlignment="Center"/></Grid>
              <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="LoginStepBadge" Style="{StaticResource StepBadge}"><TextBlock x:Name="LoginStepText" Text="2" Foreground="#AFBDD2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="LoginStepLabel" Grid.Column="1" Text="Вход" Foreground="#AFBDD2" FontSize="15" VerticalAlignment="Center"/></Grid>
              <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="LicenseStepBadge" Style="{StaticResource StepBadge}"><TextBlock x:Name="LicenseStepText" Text="3" Foreground="#AFBDD2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="LicenseStepLabel" Grid.Column="1" Text="Проверка лицензии" Foreground="#AFBDD2" FontSize="15" VerticalAlignment="Center"/></Grid>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource StepBadge}"><TextBlock Text="4" Foreground="#AFBDD2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Запуск HonestFlow" Foreground="#AFBDD2" FontSize="15" VerticalAlignment="Center"/></Grid>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="HonestFlow 3.0  ·  защищённое подключение" Foreground="#8FA1B9" FontSize="13"/>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="48,42">
          <Grid>
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center">
              <Border Width="64" Height="64" CornerRadius="16" Background="#EDF4FD" HorizontalAlignment="Left"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Blue}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Подготавливаем HonestFlow" FontSize="27" FontWeight="SemiBold" Margin="0,24,0,0"/>
              <TextBlock x:Name="LoadingDescription" Text="Получаем актуальные настройки и проверяем состояние рабочего места." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,11,0,28"/>
              <ProgressBar x:Name="StartupProgress" Height="7" Maximum="100" Value="18" Foreground="{StaticResource Blue}" Background="#E8EDF4" BorderThickness="0"/>
              <Grid Margin="0,14,0,0"><TextBlock x:Name="LoadingStatus" Text="Запуск…" Foreground="{StaticResource Muted}" FontSize="14"/><TextBlock x:Name="LoadingPercent" Text="18%" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="14"/></Grid>
            </StackPanel>

            <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" Visibility="Collapsed">
              <Border Width="64" Height="64" CornerRadius="16" Background="#EDF4FD" HorizontalAlignment="Left"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Blue}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Вход в HonestFlow" FontSize="27" FontWeight="SemiBold" Margin="0,24,0,0"/>
              <TextBlock Text="Введите пароль HonestLicenseServer. После входа конфигурация и лицензия этого компьютера будут проверены автоматически." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,11,0,18"/>
              <TextBlock Text="Пароль" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <PasswordBox x:Name="PasswordInput" Height="48" Padding="13,10" FontSize="16" BorderBrush="#CFD6E2" BorderThickness="1"/>
              <TextBlock x:Name="LoginError" Text="Введите пароль." Foreground="{StaticResource Red}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>
              <CheckBox x:Name="RememberLoginCheckBox" Content="Сохранять защищённую сессию на этом компьютере" IsChecked="True" FontSize="14" Margin="0,17,0,18"/>
              <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="Войти и продолжить" Click="Login_Click"/>
            </StackPanel>

            <StackPanel x:Name="DeviceRegistrationPanel" VerticalAlignment="Center" Visibility="Collapsed">
              <Border Width="64" Height="64" CornerRadius="16" Background="#FFF5F6" HorizontalAlignment="Left"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Red}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Регистрация устройства" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"/>
              <TextBlock Text="Введите физический адрес торговой точки. Имя этого компьютера будет передано автоматически." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,11,0,18"/>
              <TextBlock x:Name="RegistrationAddressLabel" Text="Физический адрес" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBox x:Name="RegistrationAddressInput" Height="44" MaxLength="300" Padding="13,8" FontSize="16" BorderBrush="#CFD6E2" BorderThickness="1" Margin="0,0,0,4"/>
              <TextBlock x:Name="RegistrationError" Foreground="{StaticResource Red}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>
              <Border Background="#FBFCFE" BorderBrush="#E8ECF2" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,18"><TextBlock x:Name="DeviceRegistrationStatus" Foreground="#475467" FontSize="14" LineHeight="21" TextWrapping="Wrap"/></Border>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="SubmitRegistrationButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Отправить заявку" Click="SubmitRegistration_Click"/>
                <Button x:Name="CheckRegistrationButton" Grid.Column="2" Style="{StaticResource ActionButton}" Content="Проверить снова" Click="CheckRegistration_Click"/>
              </Grid>
            </StackPanel>

            <StackPanel x:Name="LicenseMissingPanel" VerticalAlignment="Center" Visibility="Collapsed">
              <Border Width="64" Height="64" CornerRadius="16" Background="#FFF5F6" HorizontalAlignment="Left"><TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Red}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock Text="Компьютер ещё не зарегистрирован" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"/>
              <TextBlock Text="Доступ к HonestFlow появится после подтверждения этого устройства ответственным сотрудником." Foreground="{StaticResource Muted}" FontSize="15" LineHeight="23" TextWrapping="Wrap" Margin="0,11,0,24"/>
              <Border Background="#FBFCFE" BorderBrush="#E8ECF2" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,22"><TextBlock x:Name="RegistrationStatus" Text="Заявка на регистрацию отправлена автоматически. Если работа нужна сейчас, запросите удалённую помощь." Foreground="#475467" FontSize="14" LineHeight="21" TextWrapping="Wrap"/></Border>
              <Button x:Name="RequestHelpButton" Style="{StaticResource PrimaryButton}" Click="RequestHelp_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,10,0"/><TextBlock Text="Запросить помощь" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
