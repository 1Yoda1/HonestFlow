<Window x:Class="HonestFlow.WpfPrototype.CompactMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HonestFlow" Width="540" SizeToContent="Height"
        MinWidth="420" MaxWidth="560" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="CompactPrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#0868D9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#0755B5"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#064A9D"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#B8C8DE"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CompactSecondaryButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#0868D9"/>
      <Setter Property="BorderBrush" Value="#0868D9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#EAF3FF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#DCEBFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#8DA0B8"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9D4E2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CompactHelpButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#A43A4A"/>
      <Setter Property="BorderBrush" Value="#DFAAB2"/>
      <Setter Property="Background" Value="#FFF9FA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFF0F2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE2E7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#B89BA1"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E4D3D6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CompactIconButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#0868D9"/>
      <Setter Property="BorderBrush" Value="#D7E0EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#EAF3FF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#DCEBFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9BAABD"/><Setter TargetName="ButtonBorder" Property="Background" Value="#F3F5F8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="18"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border x:Name="StatusCard" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="14" Padding="22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="StatusIndicator" Background="#64748B" CornerRadius="3"/>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Состояние рабочего места" Foreground="#657083" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusTitleText" Text="Проверяем рабочее место…" Foreground="#64748B" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <TextBlock x:Name="StatusDescriptionText" Text="Пожалуйста, подождите." Foreground="#596579" FontSize="14"
                     LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock x:Name="LastCheckText" Text="Последняя проверка: ещё не выполнялась" Foreground="#7A8496" FontSize="12" Margin="0,17,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="14" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DEVICE ID" Foreground="#657083" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock x:Name="DeviceIdText" Text="Определяем…" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
        </StackPanel>
        <Button x:Name="CopyDeviceIdButton" Grid.Column="1" Width="38" Height="36" Margin="12,0,0,0" Style="{StaticResource CompactIconButton}"
                ToolTip="Скопировать Device ID" Click="CopyDeviceId_Click" IsEnabled="False">
          <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
        </Button>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="CloudStatusText" Text="Облако: проверяем" Foreground="#596579" FontSize="13"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4">
      <Button x:Name="AutoFixButton" Content="Исправить автоматически" Height="46" FontSize="14" FontWeight="SemiBold"
              Style="{StaticResource CompactPrimaryButton}" Visibility="Collapsed" Click="AutoFix_Click"/>
      <Button x:Name="HelpButton" Content="Запросить помощь" Height="44" FontSize="14" Margin="0,10,0,0" Style="{StaticResource CompactHelpButton}" Click="Help_Click"/>
      <Button x:Name="OpenFullButton" Content="Открыть HonestFlow" Height="44" FontSize="14" Margin="0,10,0,0" Style="{StaticResource CompactSecondaryButton}" Click="OpenFull_Click"/>
    </StackPanel>

    <TextBlock Grid.Row="6" x:Name="OperationText" Foreground="#657083" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
  </Grid>
</Window>
