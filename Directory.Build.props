<Project>
  <!-- Keep outputs of non-user-facing projects out of the repository tree. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build\output\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)**\bin\**;$(MSBuildThisFileDirectory)**\obj\**;$(MSBuildThisFileDirectory).build\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
