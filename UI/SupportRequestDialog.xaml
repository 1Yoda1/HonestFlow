<Window x:Class="HonestFlow.UI.SupportRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запрос удалённой помощи"
        Width="560" Height="390" MinWidth="480" MinHeight="330"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F7F9FC" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Опишите проблему" FontSize="22" FontWeight="SemiBold" Foreground="#172033"/>
    <TextBlock Grid.Row="1" Margin="0,8,0,14" Foreground="#667085" TextWrapping="Wrap"
               Text="Напишите, что произошло, что вы ожидали увидеть и какие действия уже пробовали. Это описание увидит специалист HonestDesk."/>
    <TextBox x:Name="ProblemTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" MaxLength="5000" Padding="12" FontSize="15"
             VerticalContentAlignment="Top"/>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ValidationText" Foreground="#D92D20" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Отмена" MinWidth="105" Padding="14,9" Margin="0,0,10,0" IsCancel="True"/>
        <Button Content="Отправить" MinWidth="120" Padding="14,9" IsDefault="True" Click="Send_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
