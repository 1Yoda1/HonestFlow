<Window x:Class="HonestFlow.UI.InstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инструкция"
        Width="520" Height="360" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="#F4F1E9"
        FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Инструкция" FontSize="22" FontWeight="SemiBold" Foreground="#132A2F"/>

    <Border Grid.Row="2" Background="#FFFDF8" BorderBrush="#C9C4B9" BorderThickness="1" CornerRadius="10" Padding="14">
      <ListBox x:Name="IssueTitlesList" BorderThickness="0" Background="Transparent" FontSize="15"
               Foreground="#132A2F" IsHitTestVisible="False"/>
    </Border>

    <Button Grid.Row="4" Content="Закрыть" Width="120" Height="42" HorizontalAlignment="Right"
            Background="#FFFDF8" Foreground="#132A2F" BorderBrush="#C9C4B9" BorderThickness="1"
            Padding="18,0" Click="Close_Click"/>
  </Grid>
</Window>
