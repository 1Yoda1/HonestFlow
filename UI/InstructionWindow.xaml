<Window x:Class="HonestFlow.UI.InstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инструкция"
        Width="520" Height="360" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FB"
        FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Инструкция" FontSize="22" FontWeight="SemiBold" Foreground="#182033"/>

    <Border Grid.Row="2" Background="White" BorderBrush="#DCE2EA" BorderThickness="1" CornerRadius="10" Padding="14">
      <ListBox x:Name="IssueTitlesList" BorderThickness="0" Background="Transparent" FontSize="15"
               Foreground="#182033" IsHitTestVisible="False"/>
    </Border>

    <Button Grid.Row="4" Content="Закрыть" Width="120" Height="42" HorizontalAlignment="Right"
            Background="White" Foreground="#182033" BorderBrush="#D8DEE8" BorderThickness="1"
            Padding="18,0" Click="Close_Click"/>
  </Grid>
</Window>
