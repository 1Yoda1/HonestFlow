<Window x:Class="HonestFlow.UI.DiagnosticUploadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HonestFlow — Отправка отчёта" Width="510" Height="405"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F4F6FA" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Отправляем отчёт в поддержку"
                       FontSize="22" FontWeight="SemiBold" Foreground="#172B4D" />
            <TextBlock x:Name="DescriptionText" Text="Пожалуйста, не закрывайте HonestFlow до завершения отправки."
                       Margin="0,7,0,0" Foreground="#596579" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar x:Name="Progress" Grid.Row="2" Height="10" Minimum="0" Maximum="100"
                     Value="0" Foreground="#2D8C62" Background="#DDE3EC" />

        <Border Grid.Row="4" Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock x:Name="BuildStep" Text="○  Формируем отчёт" FontSize="15" Foreground="#596579" />
                <TextBlock x:Name="UploadStep" Text="○  Отправляем в поддержку" FontSize="15" Foreground="#596579" Margin="0,13,0,0" />
                <TextBlock x:Name="VerifyStep" Text="○  Проверяем доставку" FontSize="15" Foreground="#596579" Margin="0,13,0,0" />
                <TextBlock x:Name="ResultStep" Text="○  Завершаем" FontSize="15" Foreground="#596579" Margin="0,13,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#596579" TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OpenArchiveButton" Content="Открыть архив" Height="36" Padding="14,0"
                        Visibility="Collapsed" Click="OpenArchiveButton_Click" />
                <Button x:Name="CloseButton" Content="Закрыть" Width="100" Height="36" Margin="10,0,0,0"
                        IsEnabled="False" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
